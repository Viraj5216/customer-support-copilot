GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_PRIMARY_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
LLM_STREAM_TIMEOUT_SECONDS=45
LLM_FALLBACK_TIMEOUT_SECONDS=30
LLM_FALLBACK_STREAM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS_PER_MODEL=2
LLM_TOTAL_DEADLINE_SECONDS=75
LLM_MODEL_FAILURE_THRESHOLD=2
LLM_MODEL_COOLDOWN_SECONDS=60
LLM_RETRY_INITIAL_BACKOFF_SECONDS=0.25
LLM_RETRY_MAX_BACKOFF_SECONDS=2
RETRIEVAL_MAX_DISTANCE=1.35
RETRIEVAL_HIGH_CONFIDENCE_DISTANCE=0.934
RAG_SECTION_AWARE_EMBEDDINGS=false
RAG_HYBRID_ENABLED=false
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKER_MIN_SCORE=-10.73
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
ORDERS_DB_REL_PATH=data/orders.db
CHROMA_DB_REL_PATH=chroma
POLICIES_FILE_REL_PATH=data/company_knowledge_base.txt
ORDER_DATE_ORDER=DMY
APP_TIMEZONE=Asia/Kolkata

# Optional Langfuse tracing (US Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional; stable pseudonymous Langfuse user IDs for signed-in sessions.
LANGFUSE_USER_ID_SALT=
